  Texts:
  - Key: gameplay.booster_hint.rocket
    Translations:
    - Code: en
      Text: 'Tap a door: the jellies it is waiting for disappear.'
    - Code: tr
      Text: "Bir kap\u0131ya dokun: bekledi\u011Fi jellyler yok olsun."
  - Key: gameplay.booster_hint.freeze
    Translations:
    - Code: en
      Text: Time is frozen!
    - Code: tr
      Text: Zaman donduruldu!
  - Key: gameplay.booster_hint.ufo
    Translations:
    - Code: en
      Text: 'Tap a jelly: every jelly of its colour and its doors disappear.'
    - Code: tr
      Text: "Bir jellyye dokun: o renkteki t\xFCm jellyler ve kap\u0131lar\u0131
        yok olsun."
