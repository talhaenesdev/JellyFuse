  - Key: gameplay.difficulty.super_hard
    Translations:
    - Code: en
      Text: "Super Hard"
    - Code: tr
      Text: "\u00C7ok Zor"
  - Key: notification.lives_full.title
    Translations:
    - Code: en
      Text: "Lives refilled!"
    - Code: tr
      Text: "Canlar\u0131n doldu!"
  - Key: notification.lives_full.text
    Translations:
    - Code: en
      Text: "Your lives are full. Time to fuse some jellies!"
    - Code: tr
      Text: "Canlar\u0131n tamamen doldu. J\u00F6leleri birle\u015Ftirme zaman\u0131!"
  - Key: notification.come_back_soon.title
    Translations:
    - Code: en
      Text: "The jellies miss you"
    - Code: tr
      Text: "J\u00F6leler seni \u00F6zledi"
  - Key: notification.come_back_soon.text
    Translations:
    - Code: en
      Text: "A new level is waiting. Come back and play!"
    - Code: tr
      Text: "Yeni bir b\u00F6l\u00FCm seni bekliyor. Gel ve oyna!"
  - Key: notification.come_back_later.title
    Translations:
    - Code: en
      Text: "Still there?"
    - Code: tr
      Text: "H\u00E2l\u00E2 orada m\u0131s\u0131n?"
  - Key: notification.come_back_later.text
    Translations:
    - Code: en
      Text: "Your jellies are getting bored. Jump back in!"
    - Code: tr
      Text: "J\u00F6lelerin s\u0131k\u0131lmaya ba\u015Flad\u0131. Hemen geri d\u00F6n!"
